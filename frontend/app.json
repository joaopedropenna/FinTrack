{
  "expo": {
    "name": "FinTrack",
    "slug": "fintrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#004590"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#004590"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/favicon-32.png",
      "shortName": "FinTrack",
      "name": "FinTrack — Educação Financeira",
      "themeColor": "#004590",
      "backgroundColor": "#0c121a",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
